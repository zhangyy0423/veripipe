# caches / build
__pycache__/
*.pyc
.pytest_cache/
.gocache/
.cache/
.DS_Store
build/
dist/
*.egg-info/

# runtime state (lives in the product repo cwd, never here)
.tmp/
output
*.local.json
*.local.env
configs/*.env

# private product adapters (real products stay local; the public tree ships
# only the neutral fixture at tests/fixtures/products/sample). Origin-specific
# product knowledge, hosts, and skills never enter the public history.
/products/

# private product-neutrality denylist (origin tokens stay out of the public tree)
*.denylist
tests/contract/neutrality.denylist

# editors
.idea/
.vscode/
*.swp
